{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kamyosis-program-v1",
  "title": "KAMYOSİS Program Değişim Biçimi, sürüm 1",
  "type": "object",
  "required": ["bicim", "surum", "kaynak", "program", "ders_saatleri", "dersler", "ogretmenler", "derslikler", "kisimlar", "haftalik_dersler", "yerlesim"],
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "idListesi": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
    "saat": { "type": "string", "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$" }
  },
  "properties": {
    "bicim": { "const": "kamyosis-program" },
    "surum": { "const": 1 },
    "kaynak": {
      "type": "object",
      "required": ["uygulama", "olusturma"],
      "additionalProperties": false,
      "properties": {
        "uygulama": { "type": "string", "minLength": 1 },
        "olusturma": { "type": "string", "format": "date-time" },
        "aciklama": { "type": ["string", "null"] }
      }
    },
    "program": {
      "type": "object",
      "required": ["id", "ad"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "ad": { "type": "string", "minLength": 1, "maxLength": 120 },
        "donem": { "type": ["string", "null"] },
        "onerilen_baslangic": { "type": ["string", "null"], "format": "date" }
      }
    },
    "ders_saatleri": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["no", "baslangic", "bitis"], "additionalProperties": false,
        "properties": {
          "no": { "type": "integer", "minimum": 1 },
          "baslangic": { "$ref": "#/$defs/saat" },
          "bitis": { "$ref": "#/$defs/saat" }
        }
      }
    },
    "dersler": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "kod", "ad"], "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "kod": { "type": "string", "minLength": 1, "maxLength": 30 },
          "ad": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      }
    },
    "ogretmenler": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "ad_soyad"], "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "ad_soyad": { "type": "string", "minLength": 1, "maxLength": 120 },
          "kisa_ad": { "type": ["string", "null"], "maxLength": 60 },
          "sicil": { "type": ["string", "null"], "maxLength": 30 }
        }
      }
    },
    "derslikler": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "ad"], "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "ad": { "type": "string", "minLength": 1, "maxLength": 120 },
          "kapasite": { "type": ["integer", "null"], "minimum": 0 }
        }
      }
    },
    "kisimlar": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "kod", "ad"], "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "kod": { "type": "string", "minLength": 1, "maxLength": 30 },
          "ad": { "type": "string", "minLength": 1, "maxLength": 60 },
          "tur": { "enum": ["normal", "kredi", "hazirlik", null] },
          "sinif": { "type": ["integer", "null"], "minimum": 1, "maximum": 9 }
        }
      }
    },
    "gruplar": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "kisim_id", "ad"], "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "kisim_id": { "$ref": "#/$defs/id" },
          "ad": { "type": "string", "minLength": 1, "maxLength": 60 },
          "bolunme": { "type": ["string", "null"], "maxLength": 10 }
        }
      }
    },
    "haftalik_dersler": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "ders_id", "kisim_idleri", "ogretmen_idleri", "haftalik_saat"], "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "ders_id": { "$ref": "#/$defs/id" },
          "kisim_idleri": { "allOf": [{ "$ref": "#/$defs/idListesi" }, { "minItems": 1 }] },
          "grup_idleri": { "$ref": "#/$defs/idListesi" },
          "ogretmen_idleri": { "$ref": "#/$defs/idListesi" },
          "haftalik_saat": { "type": "number", "minimum": 0 },
          "blok": { "type": ["integer", "null"], "minimum": 1 }
        }
      }
    },
    "yerlesim": {
      "type": "array",
      "items": {
        "type": "object", "required": ["haftalik_ders_id", "gun", "saat"], "additionalProperties": false,
        "properties": {
          "haftalik_ders_id": { "$ref": "#/$defs/id" },
          "gun": { "type": "integer", "minimum": 1, "maximum": 7 },
          "saat": { "type": "integer", "minimum": 1 },
          "derslik_id": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] }
        }
      }
    }
  }
}
