# Bu dosyayı .env adıyla kopyalayıp doldurun:  cp .env.example .env
# Sunucunun alan adı (DNS kaydı bu sunucuyu göstermeli), ör. program.okulum.edu.tr
DOMAIN=program.ornek.edu.tr
# Uzun ve rastgele değerler kullanın (ör. https://djecrety.ir ya da: openssl rand -base64 48)
DJANGO_SECRET_KEY=buraya-uzun-rastgele-bir-anahtar
POSTGRES_PASSWORD=buraya-guclu-bir-veritabani-parolasi
# İlk açılışta oluşturulacak merkez yönetici
ADMIN_USERNAME=merkez
ADMIN_PASSWORD=buraya-guclu-bir-parola
# Aynı anda çalışacak üretim sayısı (sunucu çekirdek sayısına göre 1-2)
WORKER_PARALLEL=1
# Saklanacak günlük yedek sayısı
BACKUP_KEEP=30

# E-posta bildirimleri (isteğe bağlı): program yayınlanınca değişen öğretmenlere ve atanan vekillere
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=
